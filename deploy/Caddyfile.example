# Canonical root routing; application rollout never overwrites shared routes.
# Prepare /opt/apps/hrms/caddy using scripts/deploy/render.mjs first.
import /etc/caddy/hrms/company-sites.caddy

finance.heliorsoft.com {
    reverse_proxy enterprise-dashboard-ui:8080
}
rms.heliorsoft.com {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
    encode gzip
    reverse_proxy rms-app:3000
}
api.heliorsoft.com {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
    encode gzip
    import /etc/caddy/hrms/legacy-routes.caddy
}
heliorsoft.com, www.heliorsoft.com, *.heliorsoft.com {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
    encode gzip
    import /etc/caddy/hrms/legacy-routes.caddy
}
:80 {
    encode gzip
    import /etc/caddy/hrms/legacy-routes.caddy
}
