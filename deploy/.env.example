KABIPAY_IMAGE_TAG=helior-003

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_DB=helior
POSTGRES_USER=appuser
POSTGRES_PASSWORD=password

KABIPAY_DB_POOL_MAX=1
KABIPAY_TENANT_DB_POOL_MAX=1
KABIPAY_REQUIRE_AUTH=1
KABIPAY_LOG_FORMAT=json

# Auth-only Docker Compose overrides. Do not apply globally to subgraphs.
KABIPAY_AUTH_DB_POOL_MAX=2
KABIPAY_AUTH_TENANT_DB_POOL_MAX=4
KABIPAY_AUTH_DB_IDLE_TIMEOUT_SECS=300
KABIPAY_AUTH_DB_ACQUIRE_TIMEOUT_SECS=15

KABIPAY_GATEWAY_PORT=4009
KABIPAY_SUBGRAPH_BASE_URL=http://kabipay-subgraphs
KABIPAY_EMPLOYEE_PUBLIC_BASE=https://api.heliorsoft.com
# Private in-container path. Both subgraphs and the cleanup worker mount the same
# host directory here; keep this absolute and do not place it under a web root.
KABIPAY_LOCAL_FILE_ROOT=/var/lib/kabipay/private-files

KABIPAY_JWT_SECRET=change-this-shared-jwt-secret-min-32-chars
# Required before employee profile-change submission is enabled. Base64-encoded 32 random bytes.
KABIPAY_PROFILE_CHANGE_ENCRYPTION_KEY=UMNpOj/GuntwybSK1LnmurJSjX1J+VKrh3+Fji5Olio=
# Generate once and store in the deployment secret manager (do not rotate without a re-encryption plan):
# PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
KABIPAY_CLIENT_ACCESS_TTL_SECS=3600
KABIPAY_OPS_ACCESS_TTL_SECS=28800
KABIPAY_REFRESH_TTL_SECS=2592000

# Offsite backup runner. Runs only when the Docker Compose "backup" profile is enabled.
BACKUP_ENABLED=false
BACKUP_CRON=0 2 * * *
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_RUN_ON_STARTUP=false
BACKUP_DATABASE=true
BACKUP_IMAGE_ARCHIVES=true
BACKUP_BUCKET=replace-with-bucket-name
BACKUP_PREFIX=helior/hrms
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=replace-with-access-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-secret-key
BACKUP_REMOTE_RETENTION_ENABLED=true
BACKUP_DATABASE_RETENTION_DAYS=30
BACKUP_IMAGE_RETENTION_DAYS=14
BACKUP_PRUNE_LOCAL_IMAGE_ARCHIVES=false
BACKUP_LOCAL_IMAGE_RETENTION_DAYS=14
