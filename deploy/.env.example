KABIPAY_IMAGE_TAG=helior-001

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_DB=helior
POSTGRES_USER=appuser
POSTGRES_PASSWORD=password

KABIPAY_DB_POOL_MAX=1
KABIPAY_TENANT_DB_POOL_MAX=1
KABIPAY_REQUIRE_AUTH=1
KABIPAY_LOG_FORMAT=json

# Auth-only Docker Compose overrides. Do not apply globally to subgraphs.
KABIPAY_AUTH_DB_POOL_MAX=2
KABIPAY_AUTH_TENANT_DB_POOL_MAX=4
KABIPAY_AUTH_DB_IDLE_TIMEOUT_SECS=300
KABIPAY_AUTH_DB_ACQUIRE_TIMEOUT_SECS=15

KABIPAY_GATEWAY_PORT=4009
KABIPAY_SUBGRAPH_BASE_URL=http://kabipay-subgraphs
KABIPAY_EMPLOYEE_PUBLIC_BASE=https://api.heliorsoft.com

KABIPAY_JWT_SECRET=change-this-shared-jwt-secret-min-32-chars
# Required before employee profile-change submission is enabled. Base64-encoded 32 random bytes.
KABIPAY_PROFILE_CHANGE_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Generate once and store in the deployment secret manager (do not rotate without a re-encryption plan):
# PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
KABIPAY_CLIENT_ACCESS_TTL_SECS=3600
KABIPAY_OPS_ACCESS_TTL_SECS=28800
KABIPAY_REFRESH_TTL_SECS=2592000
